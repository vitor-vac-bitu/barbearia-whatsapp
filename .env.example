# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (Haiku é o mais barato e rápido, ótimo para atendimento)
CLAUDE_MODEL=claude-haiku-5-5

# Postgres. No Railway, use a referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Evolution API (a mesma para todos os clientes; dá para sobrescrever por cliente no JSON)
EVOLUTION_URL=https://sua-evolution.up.railway.app
EVOLUTION_APIKEY=sua-apikey-global

# Senha das rotas /teste e /admin (use ?token=...)
ADMIN_TOKEN=troque-isto

# Senha do webhook. A URL na Evolution fica: https://seu-bot/webhook?secret=ESTE_VALOR
WEBHOOK_SECRET=troque-isto-tambem

# Opcional: quanto tempo esperar mensagens seguidas antes de responder (ms)
# AGRUPAR_MS=2500

# PORT: não defina no Railway (ele define sozinho). Localmente usa 3000.
