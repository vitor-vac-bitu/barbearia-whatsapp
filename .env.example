# Chave da API da Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo (Haiku é o mais barato e rápido, ótimo para atendimento)
CLAUDE_MODEL=claude-haiku-5-5

# Evolution API (a mesma que você já usa no Railway)
EVOLUTION_URL=https://sua-evolution.up.railway.app
EVOLUTION_APIKEY=sua-apikey-global-ou-da-instancia
EVOLUTION_INSTANCE=demo-barbearia

# Senha das rotas /teste e /agenda (use ?token=...)
ADMIN_TOKEN=troque-isto

# Porta (o Railway define sozinho)
PORT=3000
